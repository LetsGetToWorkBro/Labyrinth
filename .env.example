# IMPORTANT: Variables prefixed with VITE_ are compiled into the JS bundle at build time
# and are visible to anyone who views your app's source code in a browser.
# NEVER put secrets, API keys, or tokens in VITE_ variables.
# VITE_ variables should only contain public config (public URLs, feature flags, public IDs).
#
# Secrets that must stay server-side:
# - PASS_API_SECRET → set in Railway environment variables only (not here)
# - Any private API keys → use server-side environment variables only

# Public Sentry DSN — safe for client bundle (Sentry DSNs are designed to be public).
# Rate limiting is configured in the Sentry dashboard, not here.
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Supabase (Unified Auth) ─────────────────────────────────────────────────
# These are SAFE to put in VITE_ variables — the anon key is designed to be public.
# Row Level Security policies control what anon users can do.
# Get these from: Supabase Dashboard → Project Settings → API
#
# IMPORTANT: The cookie domain is hardcoded in client/src/lib/supabase.ts as
# '.labyrinth.vision' for cross-subdomain sharing. Update that if your domain changes.
VITE_SUPABASE_URL=https://bphlwgixwqxxsqsiuzpk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Service Role (SERVER-SIDE ONLY) ────────────────────────────────
# NEVER put this in a VITE_ variable. It bypasses all RLS policies.
# Used only in Edge Functions (invite-member) via Deno.env.get().
# Set this in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# (it is automatically available as SUPABASE_SERVICE_ROLE_KEY in all Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  <-- DO NOT commit this
